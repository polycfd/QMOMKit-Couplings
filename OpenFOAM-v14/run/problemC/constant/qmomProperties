FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      qmomProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Problem C - both operators: the blob advects while its moments grow.
//
// Identical to problem B except that a constant phase-space growth G = 0.1 is
// switched on, so this is the actual coupled problem. A constant G shifts the
// distribution rigidly, X(t) ~ N(10 + 0.1 t, 1), and the closure is exact
// (S_k = k G M_(k-1)). The exact solution is the translated blob carrying the
// raw moments of that shifted Gaussian.

nMoments        10;

phaseSpace
{
    growthModel     constant;
    growthRate      0.1;
}

qmomOptions
{
    adaptive        false;
    rmin            1e-10;
    eabs            1e-10;
    cutoff          1e-30;
}

initialDistribution
{
    mu              10;
    sigma           1;
    spatialShape    gaussianBlob;
    sigmaSpace      0.25;
    centre          (0 0 0);
}

velocityModel
{
    type            constantX;
    U0              1;
}

errorAnalysis
{
    type            advectedGaussian;
    periodicLength  2;
}

repair
{
    repairBrokenCells   false;
    m0Floor             0;
}
