FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      M;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Template field - see the note in the 1-D cases. The normal velocity on
// `sides` is exactly zero, so the boundary carries no flux and zeroGradient
// costs nothing.

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    sides
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}
